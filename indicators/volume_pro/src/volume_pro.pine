//@version=6
indicator(
     "Volume Pro", shorttitle="VOLPRO", overlay=true,
     max_boxes_count=500, max_labels_count=500, max_lines_count=500,
     max_bars_back=1000
     )

// max_bars_back is REQUIRED, not decorative: the volume-profile scan reads
// high[i]/low[i]/volume[i] with a LOOP VARIABLE, and Pine cannot infer the
// buffer depth from a dynamic index no matter how tightly the loop is bounded.
// The lookback input is capped at 900 so the buffer is always sufficient.

// A volume-analysis indicator built on INTRABAR data. The difference that makes
// everything else possible: instead of reading one volume figure per chart bar,
// it pulls the lower-timeframe bars inside each chart bar with
// request.security_lower_tf(), so buying and selling can be separated within a
// single candle — including the candle still forming.
//
// Modules:
//   • Footprint — per-price buy/sell breakdown for the last N bars, coloured by
//     which side dominated, with imbalances outlined. The right-most column is
//     the bar still forming and updates as trades print.
//   • Delta & CVD — per-bar delta (buy − sell) and cumulative delta, both live.
//   • Volume Profile — buy/sell-split rows over a longer lookback, with POC and
//     a configurable Value Area (VAH/VAL).
//   • Live dashboard — price, bar delta, buy share, CVD, POC/VAH/VAL, relative
//     volume; rebuilt on every execution.
//
// HOW "LIVE" ACTUALLY WORKS — read this before expecting a clock:
//   Pine has no timer. A script re-executes when a TRADE PRINTS, so on an active
//   symbol that is many times per second and on a quiet one it is whenever
//   something trades. Setting the intrabar resolution to 1S gives second-level
//   granularity in the DATA; it does not make the script run on a schedule.
//   The forming bar's footprint, delta and dashboard all recompute on every one
//   of those executions. The volume profile is memoised per bar — one developing
//   bar out of several hundred cannot visibly move it — and that is what keeps
//   the script fast enough to stay responsive.
//
// HONEST LIMITS — a real exchange footprint uses bid/ask to know which side was
// the aggressor. Pine does not expose bid/ask, so the side is INFERRED:
//   • "Tick Rule" — compares each intrabar close to the previous one (an uptick
//     counts as buying). The classic approximation and usually the better one.
//   • "Candle" — an intrabar closing above its open counts as buying.
//   Both are approximations. They agree with true order flow most of the time
//   and disagree at turns, which is exactly where you would most want them to be
//   right. Treat delta as a strong hint, not a measurement.
//
// PLAN REQUIREMENT — the one that decides whether this loads at all:
//   Seconds-based timeframes are served ONLY to Premium and higher plans, and
//   asking for one on a lower plan fails the ENTIRE script, not just that call.
//   So "Allow Seconds-Based Intrabars" is OFF by default and every seconds
//   resolution falls back to 1 minute. With 1-minute intrabars the footprint is
//   genuinely useful from roughly the 15-minute chart upward (15+ intrabars per
//   bar); below that there is little or nothing to split, and the dashboard says
//   so rather than drawing something meaningless.
//
//   request.security_lower_tf() also caps how many intrabars it returns per
//   chart bar, so a very fine resolution on a very high timeframe gets
//   truncated. The dashboard shows the live intrabar count for exactly this
//   reason — what the script is working with is never hidden from you.

// ————— Constants
color TRANSPARENT_COLOR = #00000000
string THEME_DARK       = "Dark"
string THEME_LIGHT      = "Light"

// ————— Inputs: Intrabar Data
string LTF_GROUP = "Intrabar Data"
string ltfModeInput = input.string(
     "Auto", "Intrabar Resolution",
     options=["Auto", "1S", "5S", "10S", "15S", "30S", "1", "5", "15"], group=LTF_GROUP,
     tooltip="Auto picks a resolution that fits the chart timeframe. Seconds-based " +
     "resolutions need a paid TradingView plan.")
bool allowSecondsInput = input.bool(
     false, "Allow Seconds-Based Intrabars", group=LTF_GROUP,
     tooltip="TradingView serves seconds-based data ONLY to Premium and higher plans. " +
     "On any lower plan a seconds resolution makes the whole script fail to load, so " +
     "this is OFF by default and any seconds choice silently falls back to 1 minute. " +
     "Turn it on only if your plan is Premium or above.")
string sideModeInput = input.string(
     "Tick Rule", "Aggressor Estimate", options=["Tick Rule", "Candle"], group=LTF_GROUP,
     tooltip="Pine cannot see bid/ask, so the side is inferred. Tick Rule compares " +
     "each intrabar close to the previous one; Candle uses close vs open.")

// ————— Inputs: Footprint
string FP_GROUP = "Footprint"
bool  showFootInput    = input.bool(true, "Show Footprint", group=FP_GROUP)
int   footBarsInput    = input.int(
     8, "Bars To Draw", minval=1, maxval=30, group=FP_GROUP,
     tooltip="Each bar costs one box per price row, against TradingView's hard cap of " +
     "500 boxes for the whole script. At high bar counts the rows per bar are reduced " +
     "automatically to fit — the dashboard shows the row count actually in use.")
int   footRowsInput    = input.int(12, "Price Rows Per Bar", minval=3, maxval=20, group=FP_GROUP)
float footImbalInput   = input.float(
     2.5, "Imbalance Ratio", minval=1.2, step=0.1, group=FP_GROUP,
     tooltip="A row is outlined when one side's volume exceeds the other by this factor.")
bool  footNumbersInput = input.bool(false, "Show Buy x Sell Numbers", group=FP_GROUP)
int   footNumBarsInput = input.int(
     2, "Bars With Numbers", minval=1, maxval=4, group=FP_GROUP)

// ————— Inputs: Delta
string DELTA_GROUP = "Delta & CVD"
bool showCvdInput  = input.bool(true, "Plot Cumulative Delta", group=DELTA_GROUP)
bool cvdResetInput = input.bool(true, "Reset CVD Each Day", group=DELTA_GROUP)
bool colorBarsInput = input.bool(
     false, "Color Bars By Delta", group=DELTA_GROUP,
     tooltip="Tints each candle by whether buying or selling dominated inside it. " +
     "This is the only way to SEE delta on an overlay script — a proper CVD pane " +
     "needs overlay=false, which would mean giving up the footprint.")

// ————— Inputs: Volume Profile
string VP_GROUP = "Volume Profile"
bool  showVpInput     = input.bool(true, "Show Volume Profile", group=VP_GROUP)
int   vpLookbackInput = input.int(300, "Lookback Bars", minval=20, maxval=900, group=VP_GROUP)
int   vpRowsInput     = input.int(60, "Price Rows", minval=10, maxval=100, group=VP_GROUP)
int   vpWidthInput    = input.int(60, "Profile Width (bars)", minval=10, maxval=200, group=VP_GROUP)
int   vpOffsetInput   = input.int(10, "Right Offset (bars)", minval=0, maxval=100, group=VP_GROUP)
float vaPercentInput  = input.float(
     70.0, "Value Area %", minval=10, maxval=100, step=5, group=VP_GROUP)
color pocColorInput   = input.color(#d98b1f, "POC Line", group=VP_GROUP)
color vaColorInput    = input.color(#5b9cf6, "Value Area Lines", group=VP_GROUP)

// ————— Inputs: Table
string TBL_GROUP = "Table"
bool   showTableInput   = input.bool(true, "Show Dashboard", group=TBL_GROUP)
string tablePosInput    = input.string(
     "Top Right", "Position",
     options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=TBL_GROUP)
int    tableTranspInput = input.int(15, "Transparency", minval=0, maxval=90, group=TBL_GROUP)

// ————— Inputs: Appearance
string themeInput    = input.string(
     THEME_DARK, "Theme", options=[THEME_DARK, THEME_LIGHT], group="Appearance")
color buyColorInput  = input.color(#089981, "Buy Color", group="Appearance")
color sellColorInput = input.color(#f23645, "Sell Color", group="Appearance")
bool  testModeInput  = input.bool(false, "Test Mode", group="Debug/Test")

// ————— Types
// One chart bar's footprint: volume split buy/sell across price rows.
type FootBar
    int   barIdx
    float lo
    float step
    float delta
    float total
    array<float> buyRows
    array<float> sellRows

// ————— Function declarations
// @function Primary text color — the value column reads first.
getTextColor(string theme) =>
    switch theme
        THEME_LIGHT => #131722
        => #d1d4dc

// @function Secondary text color — deliberately lower contrast than the value.
getMutedColor(string theme) =>
    switch theme
        THEME_LIGHT => #4a4e58
        => #b2b5be

// @function Panel background. Low transparency on purpose: at 80+ the candles
// behind the panel win and the numbers stop being readable.
getPanelColor(string theme, int transp) =>
    color base = theme == THEME_LIGHT ? #ffffff : #131722
    color.new(base, transp)

// @function Maps a position-name string to the matching position.* constant.
tablePosFrom(string name) =>
    switch name
        "Top Left"     => position.top_left
        "Bottom Right" => position.bottom_right
        "Bottom Left"  => position.bottom_left
        => position.top_right

// @function Intrabar resolution to request, targeting roughly 30-120 intrabars
// per chart bar — the sweet spot between footprint detail and the per-bar
// intrabar cap.
//
// The seconds fallback is the important part. TradingView rejects a
// seconds-based timeframe outright on anything below a Premium plan, and it
// fails the WHOLE script rather than that one call. So unless the user has
// explicitly confirmed a Premium plan, any seconds resolution — chosen directly
// or produced by Auto — is downgraded to 1 minute. A degraded footprint beats a
// script that will not load.
resolveLtf(string mode, bool allowSeconds) =>
    int chartSec = timeframe.in_seconds(timeframe.period)
    string coarse = switch
        chartSec <= 3600  => "1"
        chartSec <= 14400 => "5"
        => "15"
    string fine = switch
        chartSec <= 60    => "1S"
        chartSec <= 300   => "5S"
        chartSec <= 900   => "15S"
        => coarse
    string picked = mode == "Auto" ? (allowSeconds ? fine : coarse) : mode
    str.endswith(picked, "S") and not allowSeconds ? "1" : picked

// @function Compact human-readable volume ("1.24M", "345.6K").
formatVolume(float v) =>
    float av = math.abs(nz(v))
    switch
        av >= 1000000000 => str.tostring(v / 1000000000, "#.##") + "B"
        av >= 1000000    => str.tostring(v / 1000000, "#.##") + "M"
        av >= 1000       => str.tostring(v / 1000, "#.#") + "K"
        => str.tostring(nz(v), "#.#")

// @function One label/value table row. Both colors are required arguments,
// which is what stops a cell shipping without text_color — Pine defaults cell
// text to BLACK, invisible on a dark panel.
dashRow(table t, int row, string label, string value, color labelCol, color valueCol) =>
    table.cell(t, 0, row, label, text_color=labelCol, text_size=size.small,
         text_halign=text.align_left)
    table.cell(t, 1, row, value, text_color=valueCol, text_size=size.small,
         text_halign=text.align_right)

// @function Builds one bar's footprint from its intrabar series. Returns na when
// the feed gave us nothing usable — on some symbols and plans the intrabar
// arrays come back empty, and the caller must handle that rather than assume.
buildFootBar(array<float> o, array<float> c, array<float> v, float barHi, float barLo, int rows) =>
    FootBar result = na
    int n = array.size(v)
    if n > 0 and barHi > barLo
        float step = (barHi - barLo) / rows
        array<float> buys  = array.new<float>(rows, 0.0)
        array<float> sells = array.new<float>(rows, 0.0)
        float delta = 0.0
        float total = 0.0
        float prevClose = na
        bool useTickRule = sideModeInput == "Tick Rule"
        for i = 0 to n - 1
            float px  = array.get(c, i)
            float vol = nz(array.get(v, i))
            bool isBuy = px >= array.get(o, i)
            if useTickRule and not na(prevClose)
                isBuy := px >= prevClose
            prevClose := px
            int idx = int(math.floor((px - barLo) / step))
            idx := math.max(0, math.min(rows - 1, idx))
            if isBuy
                array.set(buys, idx, array.get(buys, idx) + vol)
                delta += vol
            else
                array.set(sells, idx, array.get(sells, idx) + vol)
                delta -= vol
            total += vol
        result := FootBar.new(
             barIdx = bar_index, lo = barLo, step = step, delta = delta,
             total = total, buyRows = buys, sellRows = sells)
    result

// @function Grows a box pool to the requested size, parking new boxes invisibly.
ensureBoxPool(array<box> pool, int needed) =>
    while array.size(pool) < needed
        array.push(pool, box.new(
             bar_index, close, bar_index, close, xloc=xloc.bar_index,
             bgcolor=TRANSPARENT_COLOR, border_color=TRANSPARENT_COLOR))

// @function Grows a label pool to the requested size.
ensureLabelPool(array<label> pool, int needed) =>
    while array.size(pool) < needed
        array.push(pool, label.new(
             bar_index, close, "", xloc=xloc.bar_index, style=label.style_none,
             color=TRANSPARENT_COLOR))

// @function Hides every pool box from `from` onward, so a shrinking draw never
// leaves stale rectangles behind.
hideBoxesFrom(array<box> pool, int from) =>
    if array.size(pool) > from
        for i = from to array.size(pool) - 1
            box.set_bgcolor(array.get(pool, i), TRANSPARENT_COLOR)
            box.set_border_color(array.get(pool, i), TRANSPARENT_COLOR)

// @function Hides every pool label from `from` onward.
hideLabelsFrom(array<label> pool, int from) =>
    if array.size(pool) > from
        for i = from to array.size(pool) - 1
            label.set_text(array.get(pool, i), "")

// @function Draws one footprint bar into the pools and returns how many boxes it
// consumed, so the caller can advance its cursor.
drawFootBar(FootBar fb, array<box> boxPool, array<label> labelPool, int boxCursor,
     int labelCursor, bool withNumbers, int rows, color buyCol, color sellCol, float imbalRatio) =>
    int used = 0
    float peak = 0.0
    for r = 0 to rows - 1
        peak := math.max(peak, array.get(fb.buyRows, r) + array.get(fb.sellRows, r))
    for r = 0 to rows - 1
        float b = array.get(fb.buyRows, r)
        float s = array.get(fb.sellRows, r)
        float t = b + s
        box bx = array.get(boxPool, boxCursor + used)
        if t > 0 and peak > 0
            float yBot = fb.lo + r * fb.step
            bool buyDom = b >= s
            float weaker = math.max(math.min(b, s), 0.000000001)
            bool imbalanced = math.max(b, s) / weaker >= imbalRatio
            color rowCol = buyDom ? buyCol : sellCol
            // Two channels so a heavy row and a lopsided row stay tellable apart:
            // opacity carries relative volume, the border carries imbalance.
            int fill = int(88 - 45 * (t / peak))
            box.set_lefttop(bx, fb.barIdx, yBot + fb.step)
            box.set_rightbottom(bx, fb.barIdx + 1, yBot)
            box.set_bgcolor(bx, color.new(rowCol, math.max(0, math.min(99, fill))))
            box.set_border_color(bx, imbalanced ? color.new(rowCol, 10) : TRANSPARENT_COLOR)
            if withNumbers
                label lb = array.get(labelPool, labelCursor + used)
                label.set_xy(lb, fb.barIdx, yBot + fb.step / 2)
                label.set_text(lb, formatVolume(b) + " x " + formatVolume(s))
                label.set_textcolor(lb, rowCol)
                label.set_size(lb, size.tiny)
        else
            box.set_bgcolor(bx, TRANSPARENT_COLOR)
            box.set_border_color(bx, TRANSPARENT_COLOR)
        used += 1
    used

// ————— Calculations: box budget
// Boxes are capped at 500 for the entire script. The profile claims its rows
// first; whatever is left is shared across the footprint bars. Reducing rows
// beats silently dropping bars, and beats hitting the cap and losing the oldest
// drawings without saying so.
int fpDrawCount = footBarsInput + 1
int fpBudget    = 480 - (showVpInput ? vpRowsInput : 0)
int fpRows      = math.max(3, math.min(footRowsInput, int(fpBudget / fpDrawCount)))

// ————— Calculations: theme and feed
color textColor  = getTextColor(themeInput)
color mutedColor = getMutedColor(themeInput)
string ltfRes    = resolveLtf(ltfModeInput, allowSecondsInput)
int    ltfSec    = timeframe.in_seconds(ltfRes)
int    chartSec  = timeframe.in_seconds(timeframe.period)
// True when the requested resolution is not actually finer than the chart, so
// there is no intrabar detail to be had — the usual cause is a low-timeframe
// chart on a plan without seconds data.
bool   ltfTooCoarse = ltfSec >= chartSec

// ONE request returning a tuple of arrays. Three separate calls would spawn
// three intrabar series over the same data and burn three of the 40 slots.
[ltfOpen, ltfClose, ltfVolume] = request.security_lower_tf(
     syminfo.tickerid, ltfRes, [open, close, volume])

int  intrabarCount = array.size(ltfVolume)
bool haveIntrabar  = intrabarCount > 0

// ————— Calculations: footprint
// The forming bar is rebuilt on every execution so it tracks trades as they
// print; a closed bar is pushed to history once and never recomputed.
var array<FootBar> footHistory = array.new<FootBar>()
FootBar currentFoot = na
if showFootInput and haveIntrabar
    currentFoot := buildFootBar(ltfOpen, ltfClose, ltfVolume, high, low, fpRows)

if barstate.isconfirmed and not na(currentFoot)
    array.push(footHistory, currentFoot)
    while array.size(footHistory) > footBarsInput
        array.shift(footHistory)

// ————— Calculations: delta and CVD
float barDelta = na(currentFoot) ? 0.0 : currentFoot.delta
float barTotal = na(currentFoot) ? nz(volume) : currentFoot.total
float buyShare = barTotal > 0 ? (barTotal + barDelta) / 2 / barTotal * 100 : na

// Only CLOSED bars accumulate; the forming bar is added on top for display.
// Accumulating the forming bar directly would double-count it once it closes.
var float cvdClosed = 0.0
bool newDay = cvdResetInput and timeframe.change("D")
if newDay
    cvdClosed := 0.0
if barstate.isconfirmed
    cvdClosed += barDelta
float cvd = barstate.isconfirmed ? cvdClosed : cvdClosed + barDelta

float volAvg = ta.sma(nz(volume), 20)
float relVol = volAvg > 0 ? nz(volume) / volAvg : na

// ————— Calculations: volume profile (memoised per bar)
// Buy/sell for a chart bar is split by where the close sits inside the bar's
// range — a far better estimate than a binary close-vs-open, and free. The
// profile spans hundreds of bars, so one developing bar cannot visibly move it;
// recomputing once per bar rather than per tick is what keeps this cheap.
var array<float> vpBuy  = array.new<float>(vpRowsInput, 0.0)
var array<float> vpSell = array.new<float>(vpRowsInput, 0.0)
var float vpLo   = na
var float vpStep = na
var float vpPoc  = na
var float vpVah  = na
var float vpVal  = na
var int   vpCachedBar = na

float scanHi = ta.highest(high, vpLookbackInput)
float scanLo = ta.lowest(low, vpLookbackInput)

// na() rather than `vpCachedBar != bar_index`: comparing against na is not
// reliable in Pine, so the != form was never true on the first pass, the scan
// never ran, and the profile silently never drew.
bool vpNeedsRebuild = na(vpCachedBar) or vpCachedBar != bar_index
if showVpInput and barstate.islast and vpNeedsRebuild
    vpCachedBar := bar_index
    vpLo   := scanLo
    vpStep := math.max(scanHi - scanLo, syminfo.mintick * vpRowsInput) / vpRowsInput
    array.fill(vpBuy, 0.0)
    array.fill(vpSell, 0.0)
    float grandTotal = 0.0
    for i = 0 to vpLookbackInput - 1
        float bHi  = high[i]
        float bLo  = low[i]
        float bVol = nz(volume[i])
        if bVol > 0 and bHi >= bLo
            float span  = bHi - bLo
            float ratio = span > 0 ? (close[i] - bLo) / span : 0.5
            ratio := math.max(0.0, math.min(1.0, ratio))
            int startIdx = int(math.floor((bLo - vpLo) / vpStep))
            int endIdx   = int(math.floor((bHi - vpLo) / vpStep))
            startIdx := math.max(0, math.min(vpRowsInput - 1, startIdx))
            endIdx   := math.max(0, math.min(vpRowsInput - 1, endIdx))
            float perBin = bVol / (endIdx - startIdx + 1)
            for r = startIdx to endIdx
                array.set(vpBuy, r, array.get(vpBuy, r) + perBin * ratio)
                array.set(vpSell, r, array.get(vpSell, r) + perBin * (1 - ratio))
            grandTotal += bVol
    float peak = 0.0
    int pocIdx = 0
    for r = 0 to vpRowsInput - 1
        float t = array.get(vpBuy, r) + array.get(vpSell, r)
        if t > peak
            peak := t
            pocIdx := r
    // Value Area: expand outward from the POC, always taking the heavier
    // neighbour, until the configured share of total volume is enclosed.
    float target = grandTotal * vaPercentInput / 100
    float acc = array.get(vpBuy, pocIdx) + array.get(vpSell, pocIdx)
    int hiIdx = pocIdx
    int loIdx = pocIdx
    bool expanding = true
    while expanding and acc < target
        float upVol = hiIdx < vpRowsInput - 1 ?
             array.get(vpBuy, hiIdx + 1) + array.get(vpSell, hiIdx + 1) : -1.0
        float dnVol = loIdx > 0 ?
             array.get(vpBuy, loIdx - 1) + array.get(vpSell, loIdx - 1) : -1.0
        if upVol < 0 and dnVol < 0
            expanding := false
        else if upVol >= dnVol
            hiIdx += 1
            acc += upVol
        else
            loIdx -= 1
            acc += dnVol
    vpPoc := vpLo + (pocIdx + 0.5) * vpStep
    vpVah := vpLo + (hiIdx + 1) * vpStep
    vpVal := vpLo + loIdx * vpStep

// ————— Visuals: volume profile
var array<box> vpBoxes = array.new<box>()
var line pocLine = na
var line vahLine = na
var line valLine = na

if showVpInput and barstate.islast and not na(vpStep)
    ensureBoxPool(vpBoxes, vpRowsInput)
    float peak = 0.0
    for r = 0 to vpRowsInput - 1
        peak := math.max(peak, array.get(vpBuy, r) + array.get(vpSell, r))
    int rightX = bar_index + vpOffsetInput + vpWidthInput
    for r = 0 to vpRowsInput - 1
        float b = array.get(vpBuy, r)
        float s = array.get(vpSell, r)
        float t = b + s
        box bx = array.get(vpBoxes, r)
        if t > 0 and peak > 0
            float yBot = vpLo + r * vpStep
            int w = math.max(1, int(math.round(t / peak * vpWidthInput)))
            bool inVa = yBot >= vpVal and (yBot + vpStep) <= vpVah
            color rowCol = b >= s ? buyColorInput : sellColorInput
            box.set_lefttop(bx, rightX - w, yBot + vpStep)
            box.set_rightbottom(bx, rightX, yBot)
            box.set_bgcolor(bx, color.new(rowCol, inVa ? 55 : 82))
            box.set_border_color(bx, color.new(rowCol, 88))
        else
            box.set_bgcolor(bx, TRANSPARENT_COLOR)
            box.set_border_color(bx, TRANSPARENT_COLOR)
    if na(pocLine)
        pocLine := line.new(bar_index, close, bar_index, close, xloc=xloc.bar_index, width=2)
        vahLine := line.new(
             bar_index, close, bar_index, close, xloc=xloc.bar_index, style=line.style_dashed)
        valLine := line.new(
             bar_index, close, bar_index, close, xloc=xloc.bar_index, style=line.style_dashed)
    line.set_xy1(pocLine, rightX - vpWidthInput, vpPoc)
    line.set_xy2(pocLine, rightX, vpPoc)
    line.set_color(pocLine, pocColorInput)
    line.set_xy1(vahLine, rightX - vpWidthInput, vpVah)
    line.set_xy2(vahLine, rightX, vpVah)
    line.set_color(vahLine, color.new(vaColorInput, 30))
    line.set_xy1(valLine, rightX - vpWidthInput, vpVal)
    line.set_xy2(valLine, rightX, vpVal)
    line.set_color(valLine, color.new(vaColorInput, 30))

// ————— Visuals: footprint
var array<box>   fpBoxes  = array.new<box>()
var array<label> fpLabels = array.new<label>()

if showFootInput and barstate.islast
    int histCount = array.size(footHistory)
    int liveCount = na(currentFoot) ? 0 : 1
    int drawCount = histCount + liveCount
    ensureBoxPool(fpBoxes, math.max(1, drawCount * fpRows))
    int numberBars = footNumbersInput ? math.min(footNumBarsInput, drawCount) : 0
    if numberBars > 0
        ensureLabelPool(fpLabels, numberBars * fpRows)
    int cursor = 0
    int labelCursor = 0
    int firstNumbered = drawCount - numberBars
    if histCount > 0
        for i = 0 to histCount - 1
            FootBar fb = array.get(footHistory, i)
            bool withNums = numberBars > 0 and i >= firstNumbered
            cursor += drawFootBar(
                 fb, fpBoxes, fpLabels, cursor, labelCursor, withNums, fpRows,
                 buyColorInput, sellColorInput, footImbalInput)
            if withNums
                labelCursor += fpRows
    if liveCount > 0
        bool withNums = numberBars > 0
        cursor += drawFootBar(
             currentFoot, fpBoxes, fpLabels, cursor, labelCursor, withNums, fpRows,
             buyColorInput, sellColorInput, footImbalInput)
        if withNums
            labelCursor += fpRows
    hideBoxesFrom(fpBoxes, cursor)
    hideLabelsFrom(fpLabels, labelCursor)

// ————— Visuals: delta series
// display= keeps these out of the price pane, where an overlay indicator has no
// business drawing a volume-scaled line — they stay readable in the data window
// and drive alerts.
plot(showCvdInput ? cvd : na, "CVD", color=cvd >= 0 ? buyColorInput : sellColorInput,
     display=display.data_window + display.status_line)
plot(barDelta, "Bar delta", color=barDelta >= 0 ? buyColorInput : sellColorInput,
     display=display.data_window + display.status_line)

// Candle tint is the overlay-compatible view of delta. The plots above stay in
// the data window because their scale is volume, not price — drawing them on a
// price pane would flatten the candles into a line.
barcolor(colorBarsInput and haveIntrabar ?
     (barDelta >= 0 ? buyColorInput : sellColorInput) : na, title="Delta bars")

// ————— Visuals: dashboard
var table dash = table.new(
     tablePosFrom(tablePosInput), 2, 10,
     bgcolor=getPanelColor(themeInput, tableTranspInput), border_width=1,
     border_color=getPanelColor(themeInput, 100),
     frame_color=color.new(mutedColor, 70), frame_width=1)

if showTableInput and barstate.islast
    color  deltaCol = barDelta >= 0 ? buyColorInput : sellColorInput
    color  cvdCol   = cvd >= 0 ? buyColorInput : sellColorInput
    string feedTxt  = not haveIntrabar ? "unavailable" :
         ltfTooCoarse ? ltfRes + "  (needs Premium)" :
         ltfRes + "  (" + str.tostring(intrabarCount) + ")"
    color  feedCol  = not haveIntrabar or ltfTooCoarse ? sellColorInput : textColor
    table.cell(dash, 0, 0, "VOLUME PRO", text_color=textColor, text_size=size.normal,
         text_halign=text.align_center)
    table.cell(dash, 1, 0, "", text_color=textColor)
    table.merge_cells(dash, 0, 0, 1, 0)
    dashRow(dash, 1, "Price", str.tostring(close, format.mintick), mutedColor, textColor)
    dashRow(dash, 2, "Bar delta", formatVolume(barDelta), mutedColor, deltaCol)
    dashRow(dash, 3, "Buy share", na(buyShare) ? "--" : str.tostring(buyShare, "#.#") + "%",
         mutedColor, nz(buyShare, 50) >= 50 ? buyColorInput : sellColorInput)
    dashRow(dash, 4, "CVD", formatVolume(cvd), mutedColor, cvdCol)
    dashRow(dash, 5, "Rel volume", na(relVol) ? "--" : str.tostring(relVol, "#.##") + "x",
         mutedColor, textColor)
    dashRow(dash, 6, "POC", na(vpPoc) ? "--" : str.tostring(vpPoc, format.mintick),
         mutedColor, pocColorInput)
    dashRow(dash, 7, "VAH / VAL", na(vpVah) ? "--" :
         str.tostring(vpVah, format.mintick) + " / " + str.tostring(vpVal, format.mintick),
         mutedColor, vaColorInput)
    dashRow(dash, 8, "Intrabar", feedTxt, mutedColor, feedCol)
    dashRow(dash, 9, "Footprint",
         str.tostring(footBarsInput) + " bars x " + str.tostring(fpRows) + " rows",
         mutedColor, fpRows < footRowsInput ? pocColorInput : textColor)

// ————— Alerts
bool deltaFlipUp   = barstate.isconfirmed and barDelta > 0 and nz(barDelta[1]) <= 0
bool deltaFlipDown = barstate.isconfirmed and barDelta < 0 and nz(barDelta[1]) >= 0
bool volSpike      = barstate.isconfirmed and not na(relVol) and relVol >= 2
alertcondition(deltaFlipUp, "Delta flipped positive", "Bar delta turned positive.")
alertcondition(deltaFlipDown, "Delta flipped negative", "Bar delta turned negative.")
alertcondition(volSpike, "Volume spike", "Bar volume is at least twice its 20-bar average.")

// ————— Debug / Test block (keep testModeInput false when handing off)
int TEST_COUNT = 4      // keep in sync with the assertFailed() calls below
var int passCount = 0
var int failCount = 0

// @function Draws a failure marker and RETURNS 1 on failure, 0 on pass. Pine
// forbids a function from modifying a global (CE10088), so the counting happens
// at the call site.
assertFailed(bool condition, string description) =>
    if not condition
        label.new(bar_index, high, "FAIL: " + description, color=sellColorInput,
             textcolor=color.white, style=label.style_label_down, size=size.small)
    condition ? 0 : 1

if testModeInput
    int fails = 0
    // 1. Delta can never exceed the volume the bar actually traded.
    fails += assertFailed(
         na(currentFoot) or math.abs(barDelta) <= barTotal + 1,
         "delta larger than bar volume")
    // 2. Buy share is a percentage.
    fails += assertFailed(
         na(buyShare) or (buyShare >= -0.01 and buyShare <= 100.01),
         "buy share outside 0-100")
    // 3. The Value Area must enclose the POC.
    fails += assertFailed(
         na(vpPoc) or na(vpVah) or na(vpVal) or (vpPoc <= vpVah and vpPoc >= vpVal),
         "POC outside the value area")
    // 4. Footprint history must respect its cap.
    fails += assertFailed(
         array.size(footHistory) <= footBarsInput, "footprint history exceeded its cap")
    failCount += fails
    passCount += TEST_COUNT - fails

var table testTable = table.new(
     position.bottom_left, 2, 2, border_width=1,
     bgcolor=getPanelColor(themeInput, tableTranspInput),
     frame_color=color.new(mutedColor, 70), frame_width=1)
if testModeInput and barstate.islast
    dashRow(testTable, 0, "Passed", str.tostring(passCount), mutedColor, buyColorInput)
    dashRow(testTable, 1, "Failed", str.tostring(failCount), mutedColor,
         failCount > 0 ? sellColorInput : buyColorInput)
