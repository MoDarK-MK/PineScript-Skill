//@version=6
indicator(
     "Reversal Pro", shorttitle="REVPRO", overlay=true,
     max_labels_count=500, max_lines_count=500, max_boxes_count=500,
     max_bars_back=1000
     )

// Pivot-based reversal detector covering the whole chart history, with a 0-5
// confirmation strength score per signal:
//   1. RSI exhaustion at the pivot bar
//   2. Volume spike at the pivot bar
//   3. Candle confirmation — price broke past the pivot candle
//   4. Wick rejection — long rejection tail on the pivot candle
//   5. Major swing — the pivot is the extreme of a wider lookback window
//
// Dashboard modules (both rebuild on every realtime tick, so they track price
// live and to the tick):
//   • Live + Bias table — a LIVE price/swing-position header plus a per-timeframe
//     UP%/DOWN% estimate of where price leans relative to that timeframe's
//     nearest pivot. The bias is a HEURISTIC confidence blend (pivot direction +
//     how the pivot held + a lite strength score + RSI momentum), NOT a
//     statistically back-tested probability.
//   • Key Levels — previous day/week/month H-L-C, day open, live current-day
//     high/low, and the most recent reversal swing high/low. Each is drawn as a
//     fully customizable horizontal line, optionally labelled with its live
//     distance from price, with the nearest level above/below highlighted.
//   • Volume Analysis — the traded volume at each reversal (on the label and in
//     its tooltip), and the highest-volume price zone BETWEEN the two most recent
//     reversals: a volume profile is built over that swing and its Point of
//     Control (the price bin that traded the most) is drawn as a box.
//   • Trade Suggestion — a BUY/SELL/WAIT readout with entry, stop, target and a
//     position size computed from your own account size and risk %.
//
// NOTE (the suggestion is not advice): it is a mechanical readout of the three
// signals this indicator already computes — last pivot direction weighted by its
// star score (45%), the multi-timeframe bias average (35%), and where price sits
// in the current swing (20%). The weights are blunt and visible on purpose; a
// tuned blend would just be fitted to past data. The script knows nothing about
// your broker, spread, margin, open positions, or anything off this chart, and
// the size arithmetic assumes the stop fills exactly at the printed price with
// no slippage or commission. Treat it as a calculator, not a recommendation.
//
// NOTE (volume zone): the zone is built from `volume` aggregated per bar at
// hlc3, not from real tick-level data — TradingView doesn't expose intrabar
// volume distribution to Pine. It is a good approximation of where trading
// concentrated, not an exchange-accurate volume profile. On instruments with no
// volume feed (many forex pairs) it degenerates to an equal-weight price range.
//
// NOTE (repainting): ta.pivothigh/pivotlow only confirm a pivot `Pivot
// Sensitivity` bars AFTER the actual high/low forms. Labels therefore appear
// with that delay and could not have been traded in real time at the pivot bar
// itself — treat them as zone markers, not instant entry signals.

// ————— Constants
int   MAX_SCORE         = 5
color TRANSPARENT_COLOR = #00000000

// ————— Inputs: Reversal
int   pivotLenInput    = input.int(15, "Pivot Sensitivity", minval=2, group="Reversal")
bool  extendLinesInput = input.bool(false, "Extend Reversal Lines", group="Reversal")
int   lineLengthInput  = input.int(20, "Fixed Line Length (if not extended)", minval=1, group="Reversal")

// ————— Inputs: Strength Filters
int   minScoreInput    = input.int(0, "Min Score To Show (0 = all)", minval=0, maxval=5, group="Strength Filters")
int   strongScoreInput = input.int(4, "'Strong' Alert Threshold", minval=1, maxval=5, group="Strength Filters")
int   rsiLenInput      = input.int(14, "RSI Length", minval=1, group="Strength Filters")
int   rsiObInput       = input.int(60, "RSI Exhaustion for Tops", minval=50, maxval=100, group="Strength Filters")
int   rsiOsInput       = input.int(40, "RSI Exhaustion for Bottoms", minval=0, maxval=50, group="Strength Filters")
int   volLenInput      = input.int(20, "Volume Average Length", minval=1, group="Strength Filters")
float volMultInput     = input.float(1.5, "Volume Spike Multiplier", minval=1.0, step=0.1, group="Strength Filters")
float wickRatioInput   = input.float(0.5, "Wick Rejection", minval=0.1, maxval=1.0, step=0.1, group="Strength Filters")
int   swingLookInput   = input.int(50, "Major Swing Lookback", minval=2, group="Strength Filters")

// ————— Inputs: Bias Table
bool   showTableInput  = input.bool(true, "Show Bias Table", group="Bias Table")
bool   showLiveInput   = input.bool(true, "Show Live Price/Swing rows", group="Bias Table")
string tablePosInput   = input.string(
     "Top Right", "Table Position",
     options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group="Bias Table")
string tableSizeInput  = input.string(
     "Small", "Table Text Size",
     options=["Tiny", "Small", "Normal", "Large"], group="Bias Table")
int    tableTranspInput = input.int(80, "Table Transparency", minval=0, maxval=100, group="Bias Table")
color  headerColInput  = input.color(color.new(#5b9cf6, 0), "Header Color", group="Bias Table")
color  upColInput      = input.color(#089981, "Up Color", group="Bias Table")
color  downColInput    = input.color(#f23645, "Down Color", group="Bias Table")
string tf1Input        = input.timeframe("1", "Bias Timeframe 1", group="Bias Table")
string tf2Input        = input.timeframe("5", "Bias Timeframe 2", group="Bias Table")
string tf3Input        = input.timeframe("15", "Bias Timeframe 3", group="Bias Table")
string tf4Input        = input.timeframe("60", "Bias Timeframe 4", group="Bias Table")
string tf5Input        = input.timeframe("240", "Bias Timeframe 5", group="Bias Table")

// ————— Inputs: Key Levels
bool   showLevelsInput = input.bool(true, "Show Key Levels", group="Key Levels")
string dayTfInput      = input.timeframe("D", "Daily Levels Timeframe", group="Key Levels")
string weekTfInput     = input.timeframe("W", "Weekly Levels Timeframe", group="Key Levels")
string monthTfInput    = input.timeframe("M", "Monthly Levels Timeframe", group="Key Levels")
bool   showPdhInput = input.bool(true, "Prev Day High", inline="pdh", group="Key Levels")
color  pdhColInput  = input.color(#f23645, "", inline="pdh", group="Key Levels")
bool   showPdlInput = input.bool(true, "Prev Day Low", inline="pdl", group="Key Levels")
color  pdlColInput  = input.color(#089981, "", inline="pdl", group="Key Levels")
bool   showPdcInput = input.bool(false, "Prev Day Close", inline="pdc", group="Key Levels")
color  pdcColInput  = input.color(#787b86, "", inline="pdc", group="Key Levels")
bool   showPwhInput = input.bool(true, "Prev Week High", inline="pwh", group="Key Levels")
color  pwhColInput  = input.color(#ff9800, "", inline="pwh", group="Key Levels")
bool   showPwlInput = input.bool(true, "Prev Week Low", inline="pwl", group="Key Levels")
color  pwlColInput  = input.color(#9c27b0, "", inline="pwl", group="Key Levels")
bool   showPmhInput = input.bool(false, "Prev Month High", inline="pmh", group="Key Levels")
color  pmhColInput  = input.color(#e91e63, "", inline="pmh", group="Key Levels")
bool   showPmlInput = input.bool(false, "Prev Month Low", inline="pml", group="Key Levels")
color  pmlColInput  = input.color(#00bcd4, "", inline="pml", group="Key Levels")
bool   showOpenInput = input.bool(false, "Day Open", inline="dopen", group="Key Levels")
color  openColInput  = input.color(#5b9cf6, "", inline="dopen", group="Key Levels")
bool   showCdhInput = input.bool(false, "Curr Day High (live)", inline="cdh", group="Key Levels")
color  cdhColInput  = input.color(#ef9a9a, "", inline="cdh", group="Key Levels")
bool   showCdlInput = input.bool(false, "Curr Day Low (live)", inline="cdl", group="Key Levels")
color  cdlColInput  = input.color(#a5d6a7, "", inline="cdl", group="Key Levels")
bool   showSwingHInput = input.bool(true, "Recent Reversal High", inline="swh", group="Key Levels")
color  swingHColInput  = input.color(#f23645, "", inline="swh", group="Key Levels")
bool   showSwingLInput = input.bool(true, "Recent Reversal Low", inline="swl", group="Key Levels")
color  swingLColInput  = input.color(#089981, "", inline="swl", group="Key Levels")
string distanceModeInput = input.string(
     "Percent", "Show Distance On Labels",
     options=["Percent", "Price", "Off"], group="Key Levels")
bool   highlightNearestInput = input.bool(true, "Highlight Nearest Level", group="Key Levels")
int    levelWidthInput = input.int(1, "Level Line Width", minval=1, maxval=4, group="Key Levels")
string levelStyleInput = input.string(
     "Dashed", "Level Line Style",
     options=["Solid", "Dotted", "Dashed"], group="Key Levels")
bool   levelExtendInput = input.bool(true, "Extend Levels Right", group="Key Levels")
int    levelLeftInput   = input.int(50, "Level Start (bars back)", minval=1, group="Key Levels")
bool   showLevelLabelsInput = input.bool(true, "Show Level Labels", group="Key Levels")
string levelLabelSizeInput  = input.string(
     "Small", "Level Label Size",
     options=["Tiny", "Small", "Normal", "Large"], group="Key Levels")

// ————— Inputs: Volume Analysis
string VOL_GROUP = "Volume Analysis"
bool   showPivotVolInput = input.bool(true, "Show Volume At Reversals", group=VOL_GROUP)
bool   showVolMultInput  = input.bool(true, "Show Volume As x Average", group=VOL_GROUP)
bool   showHvzInput      = input.bool(true, "Show High-Volume Zone Between Reversals", group=VOL_GROUP)
int    hvzRowsInput      = input.int(
     24, "Volume Profile Rows", minval=4, maxval=100, group=VOL_GROUP)
int    hvzMaxBarsInput   = input.int(
     500, "Max Bars To Scan", minval=10, maxval=900, group=VOL_GROUP)
color  hvzColorInput     = input.color(#ffb703, "Zone Color", group=VOL_GROUP)
int    hvzTranspInput    = input.int(80, "Zone Transparency", minval=0, maxval=100, group=VOL_GROUP)
bool   hvzExtendInput    = input.bool(true, "Extend Zone Right", group=VOL_GROUP)
bool   hvzMidLineInput   = input.bool(true, "Draw Zone Mid-Line (POC)", group=VOL_GROUP)
bool   hvzLabelInput     = input.bool(true, "Label The Zone", group=VOL_GROUP)

// ————— Inputs: Trade Suggestion
string SUG_GROUP = "Trade Suggestion"
bool   showSugInput      = input.bool(true, "Show Trade Suggestion", group=SUG_GROUP)
float  accountSizeInput  = input.float(
     10000, "Account Size", minval=1, step=100, group=SUG_GROUP)
float  riskPercentInput  = input.float(
     1.0, "Risk % Per Trade", minval=0.1, maxval=10.0, step=0.1, group=SUG_GROUP)
string sizeUnitInput     = input.string(
     "Units", "Size Unit",
     options=["Units", "Lots (100k)", "Mini Lots (10k)", "Micro Lots (1k)"], group=SUG_GROUP)
int    sugAtrLenInput    = input.int(14, "ATR Length (for stop)", minval=1, group=SUG_GROUP)
float  sugAtrMultInput   = input.float(
     1.5, "Stop Distance (ATR x)", minval=0.1, step=0.1, group=SUG_GROUP)
float  sugTargetRInput   = input.float(
     2.0, "Target (R multiple)", minval=0.1, step=0.1, group=SUG_GROUP)
int    minConfidenceInput = input.int(
     60, "Min Confidence To Suggest", minval=0, maxval=100, group=SUG_GROUP)

// ————— Inputs: Appearance
color bullColorInput   = input.color(#089981, "Bullish Color", group="Appearance")
color bearColorInput   = input.color(#f23645, "Bearish Color", group="Appearance")
bool  testModeInput    = input.bool(false, "Test Mode", group="Debug/Test")

// ————— Function declarations
// @function Builds a "★★★☆☆"-style strength string for a 0..MAX_SCORE score.
starString(int score) =>
    string stars = ""
    for i = 1 to MAX_SCORE
        stars := stars + (i <= score ? "★" : "☆")
    stars

// @function Text transparency for a score — weak signals fade, strong ones pop.
scoreTransp(int score) =>
    math.max(0, 50 - score * 10)

// @function Sums how many of the five confirmation flags are true (0..5).
countConfirmations(bool a, bool b, bool c, bool d, bool e) =>
    (a ? 1 : 0) + (b ? 1 : 0) + (c ? 1 : 0) + (d ? 1 : 0) + (e ? 1 : 0)

// @function Compact human-readable volume ("1.24M", "345.6K").
formatVolume(float v) =>
    float av = math.abs(nz(v))
    switch
        av >= 1000000000 => str.tostring(v / 1000000000, "#.##") + "B"
        av >= 1000000    => str.tostring(v / 1000000, "#.##") + "M"
        av >= 1000       => str.tostring(v / 1000, "#.#") + "K"
        => str.tostring(nz(v), "#.##")

// @function Multi-line tooltip describing which confirmations passed, plus the
// volume actually traded on the pivot bar and how it compares to average.
confirmationTooltip(bool rsiOk, bool volOk, bool candleOk, bool wickOk, bool swingOk,
     float pivotVol, float pivotVolAvg) =>
    string rsiTxt    = (rsiOk ? "✔" : "✘") + " RSI exhaustion at pivot"
    string volTxt    = (volOk ? "✔" : "✘") + " Volume spike at pivot"
    string candleTxt = (candleOk ? "✔" : "✘") + " Price broke past pivot candle"
    string wickTxt   = (wickOk ? "✔" : "✘") + " Rejection wick on pivot candle"
    string swingTxt  = (swingOk ? "✔" : "✘") + " Major swing extreme"
    string volLine   = "Volume at reversal: " + formatVolume(pivotVol)
    if pivotVolAvg > 0
        volLine := volLine + "  (" + str.tostring(pivotVol / pivotVolAvg, "#.##") + "x avg)"
    rsiTxt + "\n" + volTxt + "\n" + candleTxt + "\n" + wickTxt + "\n" + swingTxt +
     "\n———\n" + volLine

// @function Volume suffix appended to a reversal label, per the display inputs.
volumeSuffix(float pivotVol, float pivotVolAvg) =>
    string suffix = ""
    if showPivotVolInput
        suffix := "  " + formatVolume(pivotVol)
        if showVolMultInput and pivotVolAvg > 0
            suffix := suffix + " (" + str.tostring(pivotVol / pivotVolAvg, "#.#") + "x)"
    suffix

// @function Maps a size-name string to the matching size.* constant.
sizeFrom(string name) =>
    switch name
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal
        "Large"  => size.large
        => size.small

// @function Maps a line-style-name string to the matching line.style_* constant.
lineStyleFrom(string name) =>
    switch name
        "Solid"  => line.style_solid
        "Dotted" => line.style_dotted
        "Dashed" => line.style_dashed
        => line.style_solid

// @function Maps a position-name string to the matching position.* constant.
tablePosFrom(string name) =>
    switch name
        "Top Right"    => position.top_right
        "Top Left"     => position.top_left
        "Bottom Right" => position.bottom_right
        "Bottom Left"  => position.bottom_left
        => position.top_right

// @function Friendly short label for a timeframe string ("60" => "1H").
tfLabel(string tf) =>
    switch tf
        "1"   => "1m"
        "3"   => "3m"
        "5"   => "5m"
        "15"  => "15m"
        "30"  => "30m"
        "45"  => "45m"
        "60"  => "1H"
        "120" => "2H"
        "240" => "4H"
        "D"   => "1D"
        "W"   => "1W"
        "M"   => "1M"
        => tf

// @function Heuristic UP-probability (0..100) relative to this context's nearest
// pivot. NOT a statistical probability — a transparent confidence blend of pivot
// direction, whether price held the pivot, a lite 0-3 strength score, and RSI.
reversalBias() =>
    float ph   = ta.pivothigh(high, pivotLenInput, pivotLenInput)
    float pl   = ta.pivotlow(low, pivotLenInput, pivotLenInput)
    float r    = ta.rsi(close, rsiLenInput)
    float vAvg = ta.sma(nz(volume), volLenInput)
    var int   pivotDir   = 0            // +1 = last pivot was a low (bullish), -1 = high (bearish)
    var float pivotPrice = na
    var int   pivotScore = 0            // 0..3 lite strength of that last pivot
    if not na(pl)
        pivotDir   := 1
        pivotPrice := pl
        bool rOk = r[pivotLenInput] <= rsiOsInput
        bool vOk = nz(volume[pivotLenInput]) > vAvg[pivotLenInput] * volMultInput
        bool cOk = close > high[pivotLenInput]
        pivotScore := (rOk ? 1 : 0) + (vOk ? 1 : 0) + (cOk ? 1 : 0)
    if not na(ph)
        pivotDir   := -1
        pivotPrice := ph
        bool rOk = r[pivotLenInput] >= rsiObInput
        bool vOk = nz(volume[pivotLenInput]) > vAvg[pivotLenInput] * volMultInput
        bool cOk = close < low[pivotLenInput]
        pivotScore := (rOk ? 1 : 0) + (vOk ? 1 : 0) + (cOk ? 1 : 0)
    float conf = 8 + pivotScore * 6
    float base = pivotDir == 1 ? 50 + conf : pivotDir == -1 ? 50 - conf : 50
    float hold = 0.0
    if pivotDir == 1 and not na(pivotPrice)
        hold := close >= pivotPrice ? 6 : -6
    else if pivotDir == -1 and not na(pivotPrice)
        hold := close <= pivotPrice ? -6 : 6
    float rsiTilt = (r - 50) * 0.2
    math.round(math.max(2, math.min(98, base + hold + rsiTilt)))

// @function Fills one timeframe row of the bias table.
biasRow(table t, int rowIdx, string tfStr, float up, string txtSize) =>
    bool   valid = not na(up)
    float  dn    = valid ? 100 - up : na
    bool   upDom = valid and up >= 50
    int    upT   = not valid ? 100 : upDom ? int(80 - (up - 50) * 0.6) : 92
    int    dnT   = not valid ? 100 : upDom ? 92 : int(80 - (dn - 50) * 0.6)
    string upTxt = valid ? str.tostring(up, "#") + "%" : "--"
    string dnTxt = valid ? str.tostring(dn, "#") + "%" : "--"
    table.cell(t, 0, rowIdx, tfLabel(tfStr), text_color=color.new(chart.fg_color, 15), text_size=txtSize)
    table.cell(
         t, 1, rowIdx, upTxt, text_color=chart.fg_color, text_size=txtSize,
         bgcolor=color.new(upColInput, math.max(0, math.min(100, upT))))
    table.cell(
         t, 2, rowIdx, dnTxt, text_color=chart.fg_color, text_size=txtSize,
         bgcolor=color.new(downColInput, math.max(0, math.min(100, dnT))))

// @function Live distance suffix for a level label (percent, price, or nothing).
levelSuffix(float price) =>
    float dist = close - price
    switch distanceModeInput
        "Percent" => price != 0 ? "  (" + str.tostring(dist / price * 100, "+0.00") + "%)" : ""
        "Price"   => "  (" + str.tostring(dist, format.mintick) + ")"
        => ""

// @function Deletes and empties an array of lines.
clearLines(array<line> arr) =>
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            line.delete(array.get(arr, i))
        array.clear(arr)

// @function Deletes and empties an array of labels.
clearLabels(array<label> arr) =>
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            label.delete(array.get(arr, i))
        array.clear(arr)

// @function Collects an enabled, non-na level into the parallel price/name/color
// arrays so the nearest-level pass can see the full set before drawing.
addLevel(bool cond, float price, string name, color col, array<float> pArr, array<string> nArr, array<color> cArr) =>
    if cond and not na(price)
        array.push(pArr, price)
        array.push(nArr, name)
        array.push(cArr, col)

// @function Draws one horizontal key level (and optional live-distance label
// floated just ABOVE the line so the line never cuts through the text),
// tracking the created objects so they can be cleared and redrawn next bar.
drawOneLevel(float price, string name, color col, bool isNear, array<line> lnArr, array<label> lbArr) =>
    int x1 = math.max(0, bar_index - levelLeftInput)
    int w  = isNear ? levelWidthInput + 1 : levelWidthInput
    line ln = line.new(
         x1, price, bar_index, price, xloc=xloc.bar_index, color=col,
         width=w, style=lineStyleFrom(levelStyleInput),
         extend=levelExtendInput ? extend.right : extend.none)
    array.push(lnArr, ln)
    if showLevelLabelsInput
        string txt = name + "  " + str.tostring(price, format.mintick) + levelSuffix(price)
        label lb = label.new(
             bar_index, price, txt, xloc=xloc.bar_index, style=label.style_label_lower_left,
             color=isNear ? color.new(col, 80) : TRANSPARENT_COLOR, textcolor=col,
             size=sizeFrom(levelLabelSizeInput))
        array.push(lbArr, lb)

// ————— Calculations
float rsiValue = ta.rsi(close, rsiLenInput)
float volAvg   = ta.sma(nz(volume), volLenInput)
float highestN = ta.highest(high, swingLookInput)
float lowestN  = ta.lowest(low, swingLookInput)

float pivotHigh = ta.pivothigh(high, pivotLenInput, pivotLenInput)
float pivotLow  = ta.pivotlow(low, pivotLenInput, pivotLenInput)
bool  bearPivot = not na(pivotHigh)
bool  bullPivot = not na(pivotLow)

// Track the most recent confirmed pivots for the live swing-position readout.
var float lastPH = na
var float lastPL = na
if bearPivot
    lastPH := pivotHigh
if bullPivot
    lastPL := pivotLow

// Track the bar index of the two most recent pivots OF ANY KIND — that pair
// bounds the swing the high-volume zone is measured over. Pivots are confirmed
// pivotLenInput bars late, so the pivot itself sits at bar_index - pivotLenInput.
var int lastPivotBar = na
var int prevPivotBar = na
if bearPivot or bullPivot
    prevPivotBar := lastPivotBar
    lastPivotBar := bar_index - pivotLenInput

// Live swing position: where the current (tick) price sits between the last
// reversal low (0%) and the last reversal high (100%). Recomputed every tick.
float swingPos = na
if not na(lastPH) and not na(lastPL) and lastPH > lastPL
    swingPos := math.max(0, math.min(100, (close - lastPL) / (lastPH - lastPL) * 100))

// Pivot-bar candle geometry (pivotLenInput bars back).
float pivotRange = high[pivotLenInput] - low[pivotLenInput]
float upperWick  = high[pivotLenInput] - math.max(open[pivotLenInput], close[pivotLenInput])
float lowerWick  = math.min(open[pivotLenInput], close[pivotLenInput]) - low[pivotLenInput]

// Confirmations are evaluated at the pivot bar (pivotLenInput bars back), except
// the candle check, which uses the current confirmation bar's close.
bool volSpikeAtPivot = nz(volume[pivotLenInput]) > volAvg[pivotLenInput] * volMultInput

bool bearRsiOk    = rsiValue[pivotLenInput] >= rsiObInput
bool bearCandleOk = close < low[pivotLenInput]
bool bearWickOk   = pivotRange > 0 and upperWick >= wickRatioInput * pivotRange
bool bearSwingOk  = high[pivotLenInput] >= highestN[pivotLenInput]

bool bullRsiOk    = rsiValue[pivotLenInput] <= rsiOsInput
bool bullCandleOk = close > high[pivotLenInput]
bool bullWickOk   = pivotRange > 0 and lowerWick >= wickRatioInput * pivotRange
bool bullSwingOk  = low[pivotLenInput] <= lowestN[pivotLenInput]

int bearScore = bearPivot ? countConfirmations(bearRsiOk, volSpikeAtPivot, bearCandleOk, bearWickOk, bearSwingOk) : 0
int bullScore = bullPivot ? countConfirmations(bullRsiOk, volSpikeAtPivot, bullCandleOk, bullWickOk, bullSwingOk) : 0

string tableSize = sizeFrom(tableSizeInput)

// Per-timeframe reversal bias (heuristic UP-probability), one request per row.
float up1 = request.security(syminfo.tickerid, tf1Input, reversalBias(), lookahead=barmerge.lookahead_off)
float up2 = request.security(syminfo.tickerid, tf2Input, reversalBias(), lookahead=barmerge.lookahead_off)
float up3 = request.security(syminfo.tickerid, tf3Input, reversalBias(), lookahead=barmerge.lookahead_off)
float up4 = request.security(syminfo.tickerid, tf4Input, reversalBias(), lookahead=barmerge.lookahead_off)
float up5 = request.security(syminfo.tickerid, tf5Input, reversalBias(), lookahead=barmerge.lookahead_off)

// Completed-period levels: lookahead_on + [1] is the correct NON-repainting way
// to read a finished higher-timeframe period's high/low/close.
[pdh, pdl, pdc] = request.security(
     syminfo.tickerid, dayTfInput, [high[1], low[1], close[1]],
     lookahead=barmerge.lookahead_on)
float dayOpen = request.security(syminfo.tickerid, dayTfInput, open, lookahead=barmerge.lookahead_on)
[pwh, pwl] = request.security(
     syminfo.tickerid, weekTfInput, [high[1], low[1]], lookahead=barmerge.lookahead_on)
[pmh, pml] = request.security(
     syminfo.tickerid, monthTfInput, [high[1], low[1]], lookahead=barmerge.lookahead_on)

// Live current-day extremes: the developing period's running high/low, which
// update on every tick (intentionally "live", not the previous period).
[curDayHigh, curDayLow] = request.security(
     syminfo.tickerid, dayTfInput, [high, low], lookahead=barmerge.lookahead_off)

// Volume actually traded on the pivot bar, and the average it is measured against.
float pivotVol    = nz(volume[pivotLenInput])
float pivotVolAvg = nz(volAvg[pivotLenInput])

// ————— Calculations: trade suggestion
// A MECHANICAL READOUT of this indicator's own rules — three components vote,
// the majority sets the direction, and the margin of the vote is the confidence.
// It is not advice, it knows nothing about your broker, spread, open positions,
// or anything outside this chart. The size is arithmetic from YOUR inputs.
var int lastPivotDir   = 0    // +1 = last pivot was a LOW (turning up), -1 = a HIGH
var int lastPivotScore = 0
if bullPivot
    lastPivotDir   := 1
    lastPivotScore := bullScore
if bearPivot
    lastPivotDir   := -1
    lastPivotScore := bearScore

// Average the per-timeframe bias over whichever rows returned data.
float upSum   = 0.0
int   upCount = 0
if not na(up1)
    upSum += up1
    upCount += 1
if not na(up2)
    upSum += up2
    upCount += 1
if not na(up3)
    upSum += up3
    upCount += 1
if not na(up4)
    upSum += up4
    upCount += 1
if not na(up5)
    upSum += up5
    upCount += 1
float avgUp = upCount > 0 ? upSum / upCount : na

// Each vote is signed and bounded to -100..+100. Weights are deliberately blunt
// and visible rather than tuned — a tuned blend would just be overfitting.
float pivotVote = lastPivotDir * (lastPivotScore / MAX_SCORE) * 100
float tfVote    = na(avgUp) ? 0.0 : (avgUp - 50) * 2
float swingVote = na(swingPos) ? 0.0 : (50 - swingPos) * 2
float rawVote   = pivotVote * 0.45 + tfVote * 0.35 + swingVote * 0.20

int   sugDir        = rawVote > 0 ? 1 : rawVote < 0 ? -1 : 0
int   sugConfidence = int(math.round(math.min(100, math.abs(rawVote))))
bool  sugActive     = sugDir != 0 and sugConfidence >= minConfidenceInput
string sugAction    = not sugActive ? "WAIT" : sugDir > 0 ? "BUY" : "SELL"

float sugAtr     = ta.atr(sugAtrLenInput)
float sugStopDist = math.max(sugAtr * sugAtrMultInput, syminfo.mintick * 4)
float sugEntry   = close
float sugStop    = sugDir > 0 ? sugEntry - sugStopDist : sugEntry + sugStopDist
float sugTarget  = sugDir > 0 ? sugEntry + sugStopDist * sugTargetRInput
     : sugEntry - sugStopDist * sugTargetRInput

// Size so a full stop-out costs riskPercentInput of the stated account size.
// syminfo.pointvalue converts a 1.0 price move on one unit into account currency.
float riskCapital = accountSizeInput * riskPercentInput / 100
float perUnitRisk = sugStopDist * syminfo.pointvalue
float sugUnits    = perUnitRisk > 0 ? riskCapital / perUnitRisk : 0.0
float sugSize = switch sizeUnitInput
    "Lots (100k)"     => sugUnits / 100000
    "Mini Lots (10k)" => sugUnits / 10000
    "Micro Lots (1k)" => sugUnits / 1000
    => sugUnits

// ————— Visuals: Reversal signals
if bearPivot and bearScore >= minScoreInput
    label.new(
         bar_index[pivotLenInput], pivotHigh,
         "REVERSAL " + starString(bearScore) + volumeSuffix(pivotVol, pivotVolAvg),
         color=TRANSPARENT_COLOR,
         textcolor=color.new(bearColorInput, scoreTransp(bearScore)),
         style=label.style_label_down,
         size=bearScore == MAX_SCORE ? size.large : bearScore >= strongScoreInput ? size.normal : size.small,
         tooltip=confirmationTooltip(
             bearRsiOk, volSpikeAtPivot, bearCandleOk, bearWickOk, bearSwingOk, pivotVol, pivotVolAvg)
         )
    line.new(
         bar_index[pivotLenInput], pivotHigh,
         extendLinesInput ? bar_index : bar_index[pivotLenInput] + lineLengthInput, pivotHigh,
         color=color.new(bearColorInput, bearScore >= strongScoreInput ? 45 : 70),
         style=line.style_dotted,
         width=bearScore == MAX_SCORE ? 3 : bearScore >= strongScoreInput ? 2 : 1,
         extend=extendLinesInput ? extend.right : extend.none
         )

if bullPivot and bullScore >= minScoreInput
    label.new(
         bar_index[pivotLenInput], pivotLow,
         "REVERSAL " + starString(bullScore) + volumeSuffix(pivotVol, pivotVolAvg),
         color=TRANSPARENT_COLOR,
         textcolor=color.new(bullColorInput, scoreTransp(bullScore)),
         style=label.style_label_up,
         size=bullScore == MAX_SCORE ? size.large : bullScore >= strongScoreInput ? size.normal : size.small,
         tooltip=confirmationTooltip(
             bullRsiOk, volSpikeAtPivot, bullCandleOk, bullWickOk, bullSwingOk, pivotVol, pivotVolAvg)
         )
    line.new(
         bar_index[pivotLenInput], pivotLow,
         extendLinesInput ? bar_index : bar_index[pivotLenInput] + lineLengthInput, pivotLow,
         color=color.new(bullColorInput, bullScore >= strongScoreInput ? 45 : 70),
         style=line.style_dotted,
         width=bullScore == MAX_SCORE ? 3 : bullScore >= strongScoreInput ? 2 : 1,
         extend=extendLinesInput ? extend.right : extend.none
         )

// ————— Visuals: Live + Bias table (rebuilt every tick on the last bar)
int biasBase   = showLiveInput ? 2 : 0
int sugBase    = biasBase + 6
int tableRows  = sugBase + (showSugInput ? 6 : 0)
var table biasTable = table.new(
     tablePosFrom(tablePosInput), 3, tableRows,
     bgcolor=color.new(chart.bg_color, tableTranspInput),
     border_color=color.new(chart.fg_color, 80), border_width=1)

if showTableInput and barstate.islast
    if showLiveInput
        bool   tickUp     = close >= nz(close[1], close)
        string swingTxt   = na(swingPos) ? "--" : str.tostring(swingPos, "#") + "%"
        string swingArrow = na(swingPos) ? "" : swingPos >= 50 ? "↑" : "↓"
        color  swingCol   = na(swingPos) ? chart.fg_color : swingPos >= 50 ? upColInput : downColInput
        table.cell(biasTable, 0, 0, "PRICE", text_color=chart.fg_color, text_size=tableSize, bgcolor=headerColInput)
        table.cell(biasTable, 1, 0, str.tostring(close, format.mintick), text_color=chart.fg_color, text_size=tableSize)
        table.cell(
             biasTable, 2, 0, tickUp ? "▲" : "▼",
             text_color=tickUp ? upColInput : downColInput, text_size=tableSize)
        table.cell(biasTable, 0, 1, "SWING", text_color=chart.fg_color, text_size=tableSize, bgcolor=headerColInput)
        table.cell(biasTable, 1, 1, swingTxt, text_color=chart.fg_color, text_size=tableSize)
        table.cell(biasTable, 2, 1, swingArrow, text_color=swingCol, text_size=tableSize)
    table.cell(biasTable, 0, biasBase, "TF", text_color=chart.fg_color, text_size=tableSize, bgcolor=headerColInput)
    table.cell(biasTable, 1, biasBase, "UP", text_color=chart.fg_color, text_size=tableSize, bgcolor=headerColInput)
    table.cell(biasTable, 2, biasBase, "DOWN", text_color=chart.fg_color, text_size=tableSize, bgcolor=headerColInput)
    biasRow(biasTable, biasBase + 1, tf1Input, up1, tableSize)
    biasRow(biasTable, biasBase + 2, tf2Input, up2, tableSize)
    biasRow(biasTable, biasBase + 3, tf3Input, up3, tableSize)
    biasRow(biasTable, biasBase + 4, tf4Input, up4, tableSize)
    biasRow(biasTable, biasBase + 5, tf5Input, up5, tableSize)
    if showSugInput
        color  sugColor = not sugActive ? chart.fg_color : sugDir > 0 ? upColInput : downColInput
        string sizeTxt  = sugActive ? str.tostring(sugSize, sugSize >= 100 ? "#" : "#.####") : "--"
        string riskTxt  = sugActive ? str.tostring(riskCapital, "#.##") : ""
        string tip =
             "Mechanical readout of this indicator's own rules — NOT advice.\n" +
             "Votes: pivot " + str.tostring(pivotVote, "#") +
             " | timeframes " + str.tostring(tfVote, "#") +
             " | swing " + str.tostring(swingVote, "#") + "\n" +
             "Weighted 45/35/20 into " + str.tostring(rawVote, "#") + ".\n" +
             "Size assumes the stop below is filled exactly, and ignores spread, " +
             "commission, slippage, leverage, and any position you already hold."
        table.cell(biasTable, 0, sugBase, "SETUP", text_color=chart.fg_color,
             text_size=tableSize, bgcolor=headerColInput, tooltip=tip)
        table.cell(biasTable, 1, sugBase, sugAction, text_size=tableSize, text_color=chart.fg_color,
             bgcolor=color.new(sugColor, sugActive ? 55 : 90), tooltip=tip)
        table.cell(biasTable, 2, sugBase, str.tostring(sugConfidence) + "%",
             text_color=sugColor, text_size=tableSize, tooltip=tip)
        table.cell(biasTable, 0, sugBase + 1, "Entry", text_color=color.new(chart.fg_color, 15), text_size=tableSize)
        table.cell(biasTable, 1, sugBase + 1, sugActive ? str.tostring(sugEntry, format.mintick) : "--",
             text_color=chart.fg_color, text_size=tableSize)
        table.cell(biasTable, 2, sugBase + 1, "", text_size=tableSize)
        table.cell(biasTable, 0, sugBase + 2, "Stop", text_color=color.new(chart.fg_color, 15), text_size=tableSize)
        table.cell(biasTable, 1, sugBase + 2, sugActive ? str.tostring(sugStop, format.mintick) : "--",
             text_color=downColInput, text_size=tableSize)
        table.cell(biasTable, 2, sugBase + 2,
             sugActive and sugEntry > 0 ? str.tostring(sugStopDist / sugEntry * 100, "#.##") + "%" : "",
             text_color=color.new(chart.fg_color, 40), text_size=tableSize)
        table.cell(biasTable, 0, sugBase + 3, "Target", text_color=color.new(chart.fg_color, 15), text_size=tableSize)
        table.cell(biasTable, 1, sugBase + 3, sugActive ? str.tostring(sugTarget, format.mintick) : "--",
             text_color=upColInput, text_size=tableSize)
        table.cell(biasTable, 2, sugBase + 3, sugActive ? str.tostring(sugTargetRInput, "#.#") + "R" : "",
             text_color=color.new(chart.fg_color, 40), text_size=tableSize)
        table.cell(biasTable, 0, sugBase + 4, "Size", text_color=color.new(chart.fg_color, 15), text_size=tableSize)
        table.cell(biasTable, 1, sugBase + 4, sizeTxt, text_color=chart.fg_color, text_size=tableSize, tooltip=tip)
        table.cell(biasTable, 2, sugBase + 4, sizeUnitInput == "Units" ? "units" : "lots",
             text_color=color.new(chart.fg_color, 40), text_size=tableSize)
        table.cell(biasTable, 0, sugBase + 5, "Risk", text_color=color.new(chart.fg_color, 15), text_size=tableSize)
        table.cell(biasTable, 1, sugBase + 5, riskTxt == "" ? "--" : riskTxt,
             text_color=chart.fg_color, text_size=tableSize)
        table.cell(biasTable, 2, sugBase + 5,
             str.tostring(riskPercentInput, "#.#") + "%", text_color=color.new(chart.fg_color, 40),
             text_size=tableSize)

// ————— Visuals: Key levels (collected, then drawn with nearest-level highlight)
var array<line>   levelLines  = array.new<line>()
var array<label>  levelLabels = array.new<label>()
var array<float>  lvlPrices   = array.new<float>()
var array<string> lvlNames    = array.new<string>()
var array<color>  lvlColors   = array.new<color>()

if barstate.islast
    clearLines(levelLines)
    clearLabels(levelLabels)
    array.clear(lvlPrices)
    array.clear(lvlNames)
    array.clear(lvlColors)
    if showLevelsInput
        addLevel(showPdhInput, pdh, "PDH", pdhColInput, lvlPrices, lvlNames, lvlColors)
        addLevel(showPdlInput, pdl, "PDL", pdlColInput, lvlPrices, lvlNames, lvlColors)
        addLevel(showPdcInput, pdc, "PDC", pdcColInput, lvlPrices, lvlNames, lvlColors)
        addLevel(showPwhInput, pwh, "PWH", pwhColInput, lvlPrices, lvlNames, lvlColors)
        addLevel(showPwlInput, pwl, "PWL", pwlColInput, lvlPrices, lvlNames, lvlColors)
        addLevel(showPmhInput, pmh, "PMH", pmhColInput, lvlPrices, lvlNames, lvlColors)
        addLevel(showPmlInput, pml, "PML", pmlColInput, lvlPrices, lvlNames, lvlColors)
        addLevel(showOpenInput, dayOpen, "D.Open", openColInput, lvlPrices, lvlNames, lvlColors)
        addLevel(showCdhInput, curDayHigh, "CDH", cdhColInput, lvlPrices, lvlNames, lvlColors)
        addLevel(showCdlInput, curDayLow, "CDL", cdlColInput, lvlPrices, lvlNames, lvlColors)
        addLevel(showSwingHInput, lastPH, "Swing H", swingHColInput, lvlPrices, lvlNames, lvlColors)
        addLevel(showSwingLInput, lastPL, "Swing L", swingLColInput, lvlPrices, lvlNames, lvlColors)
        float nearAbove = na
        float nearBelow = na
        if array.size(lvlPrices) > 0
            for i = 0 to array.size(lvlPrices) - 1
                float p = array.get(lvlPrices, i)
                if p >= close and (na(nearAbove) or p < nearAbove)
                    nearAbove := p
                if p <= close and (na(nearBelow) or p > nearBelow)
                    nearBelow := p
            for i = 0 to array.size(lvlPrices) - 1
                float p = array.get(lvlPrices, i)
                bool near = false
                if highlightNearestInput
                    near := (not na(nearAbove) and p == nearAbove) or (not na(nearBelow) and p == nearBelow)
                drawOneLevel(p, array.get(lvlNames, i), array.get(lvlColors, i), near, levelLines, levelLabels)

// ————— Visuals: High-volume zone between the two most recent reversals
// A volume profile is built over the swing bounded by the last two pivots, and
// the bin that traded the most (the Point of Control) is drawn as a box. Volume
// is attributed to each bar's hlc3 — Pine has no intrabar volume distribution,
// so this locates where trading concentrated rather than reproducing an
// exchange-accurate profile.
var box   hvzBox     = na
var line  hvzMid     = na
var label hvzLabel   = na
var float hvzTop     = na
var float hvzBottom  = na
var float hvzVolume  = na

if barstate.islast
    if not na(hvzBox)
        box.delete(hvzBox)
        hvzBox := na
    if not na(hvzMid)
        line.delete(hvzMid)
        hvzMid := na
    if not na(hvzLabel)
        label.delete(hvzLabel)
        hvzLabel := na
    hvzTop    := na
    hvzBottom := na
    hvzVolume := na
    if showHvzInput and not na(lastPivotBar) and not na(prevPivotBar)
        int rightBar = math.max(lastPivotBar, prevPivotBar)
        int leftBar  = math.min(lastPivotBar, prevPivotBar)
        int rightOff = bar_index - rightBar
        int leftOff  = math.min(bar_index - leftBar, hvzMaxBarsInput)
        if leftOff > rightOff and rightOff >= 0
            float hi = high[rightOff]
            float lo = low[rightOff]
            for i = rightOff to leftOff
                hi := math.max(hi, high[i])
                lo := math.min(lo, low[i])
            float rng  = math.max(hi - lo, syminfo.mintick * hvzRowsInput)
            float step = rng / hvzRowsInput
            array<float> bins = array.new<float>(hvzRowsInput, 0.0)
            for i = rightOff to leftOff
                int idx = int(math.floor((hlc3[i] - lo) / step))
                idx := math.max(0, math.min(hvzRowsInput - 1, idx))
                array.set(bins, idx, array.get(bins, idx) + nz(volume[i], 1))
            float maxVol = 0.0
            int   pocIdx = 0
            for r = 0 to hvzRowsInput - 1
                float v = array.get(bins, r)
                if v > maxVol
                    maxVol := v
                    pocIdx := r
            hvzBottom := lo + pocIdx * step
            hvzTop    := hvzBottom + step
            hvzVolume := maxVol
            int boxRight = hvzExtendInput ? bar_index : rightBar
            hvzBox := box.new(
                 leftBar, hvzTop, boxRight, hvzBottom, xloc=xloc.bar_index,
                 bgcolor=color.new(hvzColorInput, hvzTranspInput),
                 border_color=color.new(hvzColorInput, math.max(0, hvzTranspInput - 30)),
                 extend=hvzExtendInput ? extend.right : extend.none)
            if hvzMidLineInput
                float poc = (hvzTop + hvzBottom) / 2
                hvzMid := line.new(
                     leftBar, poc, boxRight, poc, xloc=xloc.bar_index,
                     color=hvzColorInput, width=2,
                     extend=hvzExtendInput ? extend.right : extend.none)
            if hvzLabelInput
                hvzLabel := label.new(
                     boxRight, hvzTop, "HVZ  " + formatVolume(maxVol),
                     xloc=xloc.bar_index, style=label.style_label_lower_left,
                     color=TRANSPARENT_COLOR, textcolor=hvzColorInput, size=size.small,
                     tooltip="Highest-volume price zone between the last two reversals.\n" +
                     "Range: " + str.tostring(hvzBottom, format.mintick) + " - " +
                     str.tostring(hvzTop, format.mintick) + "\n" +
                     "Volume in zone: " + formatVolume(maxVol))

// ————— Alerts
alertcondition(bearPivot, "Bearish Reversal Pivot", "Bearish reversal pivot confirmed.")
alertcondition(bullPivot, "Bullish Reversal Pivot", "Bullish reversal pivot confirmed.")
alertcondition(
     bearPivot and bearScore >= strongScoreInput,
     "STRONG Bearish Reversal", "Strong bearish reversal — score at or above the alert threshold."
     )
alertcondition(
     bullPivot and bullScore >= strongScoreInput,
     "STRONG Bullish Reversal", "Strong bullish reversal — score at or above the alert threshold."
     )

// ————— Debug / Test block (keep testModeInput false when handing off)
if testModeInput
    // Assertion 1: scores must always stay inside the 0..MAX_SCORE range.
    if bearScore < 0 or bearScore > MAX_SCORE or bullScore < 0 or bullScore > MAX_SCORE
        label.new(bar_index, high, "FAIL: score out of 0-5 range", color=color.red, style=label.style_label_down)
    // Assertion 2: a score without a pivot on the same bar would be a logic bug.
    if (bearScore > 0 and not bearPivot) or (bullScore > 0 and not bullPivot)
        label.new(bar_index, high, "FAIL: score set without a pivot", color=color.red, style=label.style_label_down)
    // Assertion 3: RSI must stay within its mathematical 0-100 bounds past warm-up.
    if bar_index > rsiLenInput and not na(rsiValue) and (rsiValue < 0 or rsiValue > 100)
        label.new(bar_index, low, "FAIL: RSI out of 0-100 bounds", color=color.red, style=label.style_label_up)
    // Assertion 4: the heuristic bias must always land inside 0-100.
    if not na(up1) and (up1 < 0 or up1 > 100)
        label.new(bar_index, high, "FAIL: bias out of 0-100 bounds", color=color.red, style=label.style_label_down)
    // Assertion 5: live swing position must stay inside 0-100 when defined.
    if not na(swingPos) and (swingPos < 0 or swingPos > 100)
        label.new(bar_index, low, "FAIL: swing pos out of 0-100 bounds", color=color.red, style=label.style_label_up)
