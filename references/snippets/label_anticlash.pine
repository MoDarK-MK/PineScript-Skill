// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// LITE VARIANT — for a small fixed set of levels (no arrays needed).
// Useful when you have exactly 2–4 hard-coded key levels per bar.
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//
// @function Nudge labelY away from anchorY by at least minGap if needed.
// Returns the (possibly adjusted) Y position for the label.
// The caller is responsible for keeping lines at the true price.
nudgeLabel(float labelY, float anchorY, float minGap) =>
    math.abs(labelY - anchorY) < minGap
        ? (labelY < anchorY ? anchorY - minGap : anchorY + minGap)
        : labelY
//
// Example with 3 levels:
//   float atr   = ta.atr(14)
//   float pdh   = ta.highest(high, 1)[1]
//   float swHigh = ta.highest(high, 20)
//   float pdl   = ta.lowest(low,  1)[1]
//
//   if barstate.islast
//       float adjSwHigh = nudgeLabel(swHigh, pdh, atr * 0.4)
//       label.set_y(swingLabel, adjSwHigh)
//       // pdh line and label stay at true pdh price
